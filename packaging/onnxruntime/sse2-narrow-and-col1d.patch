+    if (CountN <= 4) {
+        if (CountM >= 6) return MlasSgemmNarrowTileSse<6, 1>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
+        if (CountM >= 4) return MlasSgemmNarrowTileSse<4, 1>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
+        if (CountM >= 2) return MlasSgemmNarrowTileSse<2, 1>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
+        return MlasSgemmNarrowTileSse<1, 1>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
+    } else {
+        if (CountM >= 4) return MlasSgemmNarrowTileSse<4, 2>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
+        if (CountM >= 2) return MlasSgemmNarrowTileSse<2, 2>(A, B, C, CountK, CountN, lda, ldc, alpha, ZeroMode);
