def secure_directory(path):
    for directory in reversed((path, *path.parents)):
        if not directory.exists():
            directory.mkdir(mode=0o755)
            directory.chmod(0o755)
        info = directory.lstat()
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError(f"directory is not root-controlled: {directory}")


def copy_archive(source, destination, selected=None):
    selected = selected if selected is not None else archive_for(platform.machine())
    fd = os.open(source, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size != selected["size"]:
            raise ValueError("archive is not a regular file of the pinned size")
        with destination.open("xb") as output:
            remaining = selected["size"]
            while remaining:
                block = stream.read(min(remaining, 1024 * 1024))
                if not block:
                    raise ValueError("archive changed during copy")
                output.write(block)
                remaining -= len(block)
            if stream.read(1):
                raise ValueError("archive grew during copy")


def verify_archive(path, selected=None):
    selected = selected if selected is not None else archive_for(platform.machine())
    if path.stat().st_size != selected["size"]:
        raise ValueError("converter archive size mismatch")
    with path.open("rb") as stream:
        if hashlib.file_digest(stream, "sha256").hexdigest() != selected["sha256"]:
            raise ValueError("converter archive SHA-256 mismatch")


def extract_payload(stream, destination, mono_sha256=None):
    """Extract bounded ordinary files only, without trusting tar metadata."""
    seen = set()
    total = 0
    with tarfile.open(fileobj=stream, mode="r|") as archive:
        for member in archive:
            name = member.name.removeprefix("./").rstrip("/")
            if name in ("", ".") and member.isdir():
                continue
            path = PurePosixPath(name)
            if (not name or path.is_absolute() or ".." in path.parts
                    or path.as_posix() != name or name in seen):
                raise ValueError("unsafe or duplicate converter archive path")
            seen.add(name)
            if len(seen) > MAX_MEMBERS:
                raise ValueError("too many converter archive members")
            target = destination.joinpath(*path.parts)
            if name == MONO_RUNTIME and (not mono_sha256 or not member.isfile()):
                raise ValueError("unexpected mono runtime in converter archive")
            if member.isdir():
                target.mkdir(mode=0o755, parents=True, exist_ok=True)
            elif member.isfile():
                total += member.size
                if member.size < 0 or total > MAX_UNPACKED_BYTES:
                    raise ValueError("converter archive exceeds extraction bound")
                target.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
                with archive.extractfile(member) as source:
                    if name == MONO_RUNTIME:
                        if hashlib.file_digest(source, "sha256").hexdigest() != mono_sha256:
                            raise ValueError("discarded mono runtime checksum mismatch")
                        continue
                    with target.open("xb") as output:
                        shutil.copyfileobj(source, output, 1024 * 1024)
                target.chmod(0o755 if member.mode & 0o111 else 0o644)
            else:
                raise ValueError("converter archive contains a link or special file")
    for directory, _subdirs, _files in os.walk(destination):
        Path(directory).chmod(0o755)
    for name in PAYLOAD_FILES:
        if name == MONO_RUNTIME and mono_sha256 is None:
            continue
        if name not in seen or (name != MONO_RUNTIME and not (destination / name).is_file()):
            raise ValueError(f"converter archive missing {name}")


def inventory(root, *, owner=0):
    records = {}
    for directory, subdirs, files in os.walk(root, followlinks=False):
        for name in subdirs + files:
            path = Path(directory) / name
            info = path.lstat()
            if info.st_uid != owner or info.st_mode & 0o022:
                raise ValueError(f"installed converter entry is not root-controlled: {path}")
            relative = path.relative_to(root).as_posix()
            if stat.S_ISREG(info.st_mode):
                with path.open("rb") as stream:
                    records[relative] = (stat.S_IMODE(info.st_mode), hashlib.file_digest(stream, "sha256").hexdigest())
            elif stat.S_ISDIR(info.st_mode):
                records[relative] = (stat.S_IMODE(info.st_mode), None)
            else:
                raise ValueError(f"installed converter contains a link or special file: {path}")
    return records


def expected_inventory(selected=None, *, shared=False):
    selected = selected if selected is not None else archive_for(platform.machine())
    result = {"bin": (0o755, None), ".converter": (0o755, None), ".converter-48khz": (0o755, None)}
    result.update({name: (0o755 if name.startswith("bin/") else 0o644, digest)
                   for name, digest in selected["files"].items()})
    if shared:
        del result[MONO_RUNTIME]
        for name, digest in selected["shared"].items():
            result[name] = (result[name][0], digest)
    return result


def stage_installed(payload, selected):
    # The existing release inventory was checked under the install lock.
    # Reuse its large runtime inode. Only the three rewritten files need copies.
    for directory in ("bin", ".converter", ".converter-48khz"):
        (payload / directory).mkdir(mode=0o755)
        (payload / directory).chmod(0o755)
    for name in selected["files"]:
        if name == MONO_RUNTIME:
            continue
        if name in selected["shared"]:
            shutil.copy2(DESTINATION / name, payload / name)
        else:
            os.link(DESTINATION / name, payload / name)


def transfer_for(selected, supplied):
    compact = selected.get("compact", {})
    if supplied is None:
        return compact if compact.get("url") else selected
    return compact if supplied.lstat().st_size == compact.get("size") else selected


def stage_download(stage, payload, selected, supplied):
    transfer = transfer_for(selected, supplied)
    is_shared = transfer is not selected
    if shutil.disk_usage(stage).free < transfer["size"] + selected["installed_bytes"]:
        raise ValueError("insufficient free space for converter download and shared runtime")
    archive = stage / "converter.tar.zst"
    if supplied:
        copy_archive(supplied, archive, transfer)
    else:
        subprocess.run(["/usr/bin/curl", "--fail", "--location", "--silent", "--show-error",
                        "--proto", "=https", "--proto-redir", "=https", "--connect-timeout", "20",
                        "--max-time", "900", "--max-filesize", str(transfer["size"]),
                        "--output", str(archive), transfer["url"]], check=True)
    verify_archive(archive, transfer)
    with subprocess.Popen(["/usr/bin/zstd", "--decompress", "--stdout", str(archive)],
                          stdout=subprocess.PIPE) as process:
        try:
            with process.stdout:
                extract_payload(process.stdout, payload, None if is_shared else selected["files"][MONO_RUNTIME])
                while process.stdout.read(1024 * 1024):
                    pass
            if process.wait() != 0:
                raise ValueError("converter decompression failed")
        finally:
            if process.poll() is None:
                process.kill()
    archive.unlink()
    return is_shared


def clear_stage(stage):
    try:
        info = stage.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.geteuid() or stat.S_IMODE(info.st_mode) != 0o700:
        raise ValueError("unsafe converter staging directory")
    shutil.rmtree(stage)


def publish_upgrade(payload):
    # Linux renameat2(RENAME_EXCHANGE) keeps one complete installation visible.
    libc = ctypes.CDLL(None, use_errno=True)
    if libc.renameat2(-100, os.fsencode(payload), -100, os.fsencode(DESTINATION), 2):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), DESTINATION)


def install_locked(selected, supplied):
    stage = DESTINATION.parent / ".encodec-converter-stage"
    expected = expected_inventory(selected, shared=True)
    upgrading = os.path.lexists(DESTINATION)
    if upgrading:
        secure_directory(DESTINATION)
        current = inventory(DESTINATION)
        if current == expected:
            clear_stage(stage)
            print("Exact shared converter already installed")
            return
        if current != expected_inventory(selected):
            raise ValueError("existing converter differs; refusing to overwrite it")
    # A killed installer may leave a partial download or the old exchanged tree.
    # This private directory is owned by the installer under the same lock.
    clear_stage(stage)
    stage.mkdir(mode=0o700)
    try:
        payload = stage / "payload"
        payload.mkdir(mode=0o755)
        payload.chmod(0o755)
        if upgrading:
            stage_installed(payload, selected)
            share_runtime(payload, selected)
        elif not stage_download(stage, payload, selected, supplied):
            share_runtime(payload, selected)
        if inventory(payload) != expected:
            raise ValueError("shared converter differs from the pinned inventory")
        if upgrading:
            publish_upgrade(payload)
        else:
            payload.rename(DESTINATION)
    finally:
        clear_stage(stage)
    print(f"Installed shared converter at {DESTINATION}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--archive", type=Path, help="use a local copy of the exact pinned archive")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()
    selected = archive_for(platform.machine())
    if selected["size"] <= 0 or len(selected["sha256"]) != 64:
        raise ValueError("converter release archive has not been selected")
    if args.dry_run:
        transfer = transfer_for(selected, args.archive)
        print(f"Required conversion software; no model weights or licence receipts.\n"
              f"{args.archive or transfer['url']}\nbytes={transfer['size']} sha256={transfer['sha256']}\n"
              f"Installed bytes={selected['installed_bytes']} at {DESTINATION}")
        return
    if os.geteuid() != 0:
        raise ValueError("run as root on a supported architecture")
    for package in ("libgomp1", "libstdc++6", "python3", "bubblewrap", "zstd"):
        dependency = subprocess.run(
            ["/usr/bin/dpkg-query", "-W", "-f=${db:Status-Status}", package],
            capture_output=True, text=True,
        )
        if dependency.returncode or dependency.stdout.strip() != "installed":
            raise ValueError(f"install the Debian {package} package before the converter")
    secure_directory(DESTINATION.parent)
    lock_fd = os.open(DESTINATION.parent / ".encodec-converter.lock",
                      os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    with os.fdopen(lock_fd, "w") as lock:
        info = os.fstat(lock.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o077:
            raise ValueError("unsafe converter installation lock")
        fcntl.flock(lock, fcntl.LOCK_EX)
        install_locked(selected, args.archive)
    print("Next, as your normal user: kilix models install encodec-24khz-stateful")


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, tarfile.TarError, subprocess.SubprocessError) as error:
        raise SystemExit(f"encodec converter: {error}")
