def share_runtime(root, selected):
    """Bind the mono command to the released stereo runtime's verified superset.

    Inputs are the pinned release files. The executable keeps its original
    template, model inputs, output digests and embedded licence authority.
    """
    mono = json.loads((root / MONO_RECEIPT).read_bytes())
    stereo = json.loads((root / STEREO_RECEIPT).read_bytes())
    if not mono["runtime_files"] or any(stereo["runtime_files"].get(path) != entry
                                        for path, entry in mono["runtime_files"].items()):
        raise ValueError("stereo runtime does not contain the exact mono runtime files")

    command = (root / MONO_COMMAND).read_text(encoding="utf-8")
    edits = {
        f'BUNDLE_SHA256 = "{mono["runtime_tar_sha256"]}"':
            f'BUNDLE_SHA256 = "{stereo["runtime_tar_sha256"]}"',
        f'BUNDLE_BYTES = int("{mono["runtime_tar_bytes"]}")':
            f'BUNDLE_BYTES = int("{stereo["runtime_tar_bytes"]}")',
        f'RUNTIME_BYTES = int("{mono["runtime_bytes"]}")':
            f'RUNTIME_BYTES = int("{stereo["runtime_bytes"]}")',
        # PROFILE is canonical JSON embedded as hex by build_converter.py.
        b'"directory":".converter"'.hex(): b'"directory":".converter-48khz"'.hex(),
    }
    for old, new in edits.items():
        if command.count(old) != 1:
            raise ValueError("unexpected mono launcher in converter distribution")
        command = command.replace(old, new)
    (root / MONO_COMMAND).write_text(command, encoding="utf-8")

    for key in ("runtime_files", "runtime_bytes", "runtime_tar_bytes", "runtime_tar_sha256"):
        mono[key] = stereo[key]
    mono["shared_runtime"] = SHARED_RUNTIME
    mono["command_sha256"] = hashlib.sha256(command.encode()).hexdigest()
    (root / MONO_RECEIPT).write_text(json.dumps(mono, sort_keys=True, indent=2) + "\n", encoding="utf-8")

    upstream = json.loads((root / "BUILD.json").read_bytes())
    build = {"schema": "kilix.encodec.converter-distribution/v2",
             "architecture": upstream["architecture"], "source_commit": upstream["source_commit"],
             "source_distribution_sha256": selected["sha256"], "upstream_build": upstream,
             "profiles": ["24khz", "48khz"], "model_payloads_included": False,
             "shared_runtime": SHARED_RUNTIME, "runtime_file_count": len(stereo["runtime_files"]),
             "files": {}}
    for name, digest in selected["files"].items():
        if name in (MONO_RUNTIME, "BUILD.json"):
            continue
        path = root / name
        if name in (MONO_COMMAND, MONO_RECEIPT):
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
        build["files"][name] = {"bytes": path.stat().st_size, "sha256": digest}
    (root / "BUILD.json").write_text(json.dumps(build, sort_keys=True, indent=2) + "\n", encoding="utf-8")


