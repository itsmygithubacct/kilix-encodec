#!/bin/sh
set -eu
if [ "${1:-}" = remove ] || [ "${1:-}" = purge ]; then
    root=/usr/lib/plebian-os
    if [ -d "$root/kilix-encodec" ] || [ -e "$root/.encodec-converter.lock" ]; then
        umask 077
        (
            flock -x 9
            rm -rf "$root/kilix-encodec" "$root/.encodec-converter-stage"
        ) 9>>"$root/.encodec-converter.lock"
        # Provisioning may already be waiting on this same lock inode.
    fi
fi
#DEBHELPER#
exit 0
